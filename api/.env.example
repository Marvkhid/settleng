# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated website URLs allowed to call this API. In production this is REQUIRED and must be exact,
# e.g. https://settleng.vercel.app  (a single * inside a host is allowed for preview URLs: https://settleng-*.vercel.app)
CORS_ORIGIN=http://localhost:3000

# --- Database: Supabase PostgreSQL (via Prisma) ---
# Runtime: the pooled connection (Supavisor, transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:6543/postgres
# Migrations (prisma migrate deploy): the direct/session connection (port 5432).
DIRECT_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Optional: SSL is on automatically for remote databases. Provide Supabase's CA certificate to verify it fully
# (paste the PEM with \n for line breaks), or set DATABASE_SSL=false to turn SSL off.
# DATABASE_CA=
# DATABASE_SSL=
# DATABASE_POOL_MAX=10

# --- Auth: Supabase ---
# Your Supabase project URL. The API verifies access tokens against this project's JWKS
# (https://<SUPABASE_URL>/auth/v1/.well-known/jwks.json). REQUIRED in production.
SUPABASE_URL=https://[project].supabase.co
# Alternative to SUPABASE_URL for local/tests only: a shared HS256 secret. Leave unset in production
# when using JWKS. Never commit a real secret.
# SUPABASE_JWT_SECRET=

# REQUIRED for account deletion (DELETE /api/auth/account). The API uses it to remove the auth user.
# Server-side only: never put this in the web app or any NEXT_PUBLIC_ variable.
# Supabase Dashboard -> Project Settings -> API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Set to "true" to disable rate limiting (never in production).
# THROTTLE_DISABLED=true

# --- Email delivery (signup alert, Smart Debt Reminders, debtor reminders) ---
# Server-side only: never copy these into the web app or any NEXT_PUBLIC_ variable.
# `gmail` (temporary) or `resend` (production). Leave unset to use whichever is configured below,
# preferring Gmail when both are present.
# EMAIL_PROVIDER=gmail
#
# Gmail SMTP (smtp.gmail.com:587, STARTTLS). GMAIL_APP_PASSWORD is the 16-character Google *app
# password* (2-Step Verification required, https://myaccount.google.com/apppasswords) — the normal
# account password is rejected.
# GMAIL_USER=settleng.mail@gmail.com
# GMAIL_APP_PASSWORD=
# Optional display sender. Defaults to "SettleNG <GMAIL_USER>"; Gmail refuses a From it does not own.
# GMAIL_FROM=
#
# Resend, kept for production: https://resend.com/api-keys
# RESEND_API_KEY=
# RESEND_FROM=SettleNG <reminders@yourdomain.com>

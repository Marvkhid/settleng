# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated website URLs allowed to call this API. In production this is REQUIRED and must be exact,
# e.g. https://settleng.vercel.app  (a single * inside a host is allowed for preview URLs: https://settleng-*.vercel.app)
CORS_ORIGIN=http://localhost:3000
DEMO_MODE=true

# --- Database: Supabase used ONLY as managed PostgreSQL (via Prisma) ---
# Runtime: the pooled connection (Supavisor, transaction mode, port 6543). Replace the placeholders.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migrations and seeding: the direct or session connection (port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Optional: SSL is on automatically for remote databases. Provide Supabase's CA certificate to verify it fully
# (paste the PEM with \n for line breaks), or set DATABASE_SSL=false to turn SSL off.
# DATABASE_CA=
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10
